{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "玩家状态机 · 核心战斗环",
    "locale": "zh-CN",
    "output": "diagrams/player-fsm.html",
    "viewBox": [980, 660],
    "animation": "trace",
    "quality_profile": "showcase",
    "views": [
      {
        "id": "main-loop",
        "label": "移动主循环",
        "focus": ["idle", "move", "jump", "fall"],
        "note": "Idle 与 Move 由水平输入互切；起跳逻辑位于 Grounded 超集，地面或土狼时间内均可生效；Fall 落地闭合回 Idle。"
      },
      {
        "id": "counter-chain",
        "label": "反击到追击链路",
        "focus": ["counter_attack", "basic_attack"],
        "note": "反击命中开启 0.5s 追击窗口；追击到达或超时后把连击索引强制设为 3，直接接第三段收招。"
      }
    ]
  },
  "lanes": [
    { "id": "main", "label": "移动主循环" },
    { "id": "terminal", "label": "攻击与反击" }
  ],
  "states": [
    {
      "id": "idle",
      "type": "start",
      "label": "Idle 待机",
      "sublabel": "清零水平速度",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "grounded"
    },
    {
      "id": "move",
      "type": "active",
      "label": "Move 移动",
      "sublabel": "xInput × moveSpeed",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "grounded"
    },
    {
      "id": "jump",
      "type": "active",
      "label": "Jump 起跳",
      "sublabel": "jumpCount++",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "airborne"
    },
    {
      "id": "fall",
      "type": "active",
      "label": "Fall 下落",
      "sublabel": "vy < 0",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "airborne"
    },
    {
      "id": "counter_attack",
      "type": "decision",
      "label": "CounterAttack 反击",
      "sublabel": "仅命中敌人窗口",
      "lane": "terminal",
      "col": 0,
      "step": "05",
      "tag": "counter"
    },
    {
      "id": "basic_attack",
      "type": "active",
      "label": "BasicAttack 普攻",
      "sublabel": "3 段连击 · 追击后接第 3 段",
      "lane": "terminal",
      "col": 1,
      "step": "06",
      "tag": "combo"
    }
  ],
  "transitions": [
    { "id": "t_idle_move", "from": "idle", "to": "move", "route": "straight" },
    { "id": "t_move_jump", "from": "move", "to": "jump", "route": "straight" },
    { "id": "t_jump_fall", "from": "jump", "to": "fall", "route": "straight" },
    { "id": "t_fall_attack", "from": "fall", "to": "basic_attack" },
    { "id": "t_move_counter", "from": "move", "to": "counter_attack" },
    { "id": "t_counter_attack", "from": "counter_attack", "to": "basic_attack", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "移动主循环",
      "items": [
        "Idle 与 Move 由水平输入单向互切，无中间态",
        "起跳逻辑位于 Grounded 超集：地面或土狼时间内均可生效",
        "Fall 检测 isOnGround 后直接闭合回 Idle，形成环回"
      ]
    },
    {
      "dot": "violet",
      "title": "全局中断系统",
      "items": [
        "冲刺与反击写在 PlayerState 基类 Update 中，只实现一次",
        "反击以黑名单排除死亡、领域展开、反击与追击四态",
        "冲刺缓冲消费后立即 Clear，保证单次消费语义"
      ]
    },
    {
      "dot": "amber",
      "title": "反击到追击的交接协议",
      "items": [
        "命中即关闭敌人反击窗口，防顿帧延迟期被二次反击",
        "追击接管无敌帧所有权，并显式禁用顿帧避免 FreezeAll 卡住突进",
        "追击结束把连击索引强制设为 3，接第三段收招加成"
      ]
    }
  ]
}
